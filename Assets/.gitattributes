# Handle line endings automatically
* text=auto

# Force Unity files to use LF (to prevent constant merge conflicts)
*.asset text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.controller text eol=lf

# Ensure scripts use auto-detection
*.cs text
*.json text
*.shader text

# Mark binary files as binary (do NOT touch line endings)
*.jpg binary
*.png binary
*.fbx binary
*.obj binary
*.mp3 binary
*.wav binary
*.tga binary
*.cubemap binary