      m_Calls: []
  m_text: "Before the study begins, please read the instructions carefully:\n \nIn
    this study, you will learn neuroscience knowledge about different brain regions.
    \n\nThe study consists of three learning blocks. Each learning block includes
    a learning phase followed by a short quiz.\n\r\nDuring each block:\r\nYou will
    first complete a learning phase (9 minutes).\n\r\nAfter the learning phase, you
    will complete a short quiz (3 minutes) to assess your understanding of the material.\n\r\nAfter
    the quiz, you will have a 2-minute break before starting the next learning block.\n\r\nThis
    sequence will repeat for all three learning blocks and the study will end when
    you see \u201CEnd\u201D displayed in the program.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
