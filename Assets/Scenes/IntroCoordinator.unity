  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Learning Phase\r\n1. In each learning block, you will spend approximately
    9 minutes reviewing three learning segments presented in sequence:\r\n\tA. Brain
    Lobe (3 minutes)\r\n\tB. Region of Interest (ROI) within the lobe (3 minutes)\r\n\tC.
    Specific Brain Structure (3 minutes)\n\r\n2. Each segment will present information
    about:\r\n\tA. Anatomical location\r\n\tB. Function\r\n\tC. Clinical relevance\n\r\n3.
    A countdown timer will be displayed in the top right corner.\r\nWhen the time
    is over, the program will automatically move to the next segment.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
