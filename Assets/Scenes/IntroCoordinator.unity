      m_Calls: []
  m_text: "Short quiz (3 minutes)\r\nAfter the learning phase, you will complete
    a short quiz consisting of three multiple-choice questions (MCQs) related to:\r\n\tA.
    Anatomical location\r\n\tB. Function\r\n\tC. Clinical relevance\n\r\nYou will
    have 1 minute to answer each question, for a total of 3 minutes.\n\r\nAfter completing
    the quiz, the program will automatically move to the next learning block.\n\r\nYou
    will be given a 2 minute break between learning blocks. During the 2 minute break,
    please follow the on-screen instructions to adjust the learning mode (e.g., headset
    on or headset off) as required.\r\n\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
